{
  "name": "flowsight-ai",
  "version": "5.0.9",
  "private": true,
  "description": "FlowSight AI - Privacy-first work activity monitor with local AI",
  "scripts": {
    "dev": "corepack pnpm --filter @flowsight/agent dev",
    "dev:stable": "corepack pnpm --filter @flowsight/agent dev:stable",
    "tauri": "corepack pnpm --filter @flowsight/agent exec tauri",
    "build": "corepack pnpm --filter @flowsight/agent build",
    "catalog:apps": "cargo run --manifest-path tools/popular-apps-catalog/Cargo.toml"
  },
  "workspaces": [
    "apps/*"
  ],
  "packageManager": "pnpm@8.15.0",
  "engines": {
    "node": ">=20.9.0",
    "pnpm": ">=8.0.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "2.11.2",
    "@types/node": "20.19.0",
    "playwright": "1.62.1"
  }
}
