{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "FlowSight Agent",
  "version": "5.0.6",
  "identifier": "ai.flowsight.agent",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://127.0.0.1:1420",
    "beforeDevCommand": "corepack pnpm --filter @flowsight/agent vite",
    "beforeBuildCommand": "corepack pnpm --filter @flowsight/agent vite build"
  },
  "app": {
    "windows": [
      {
        "title": "FlowSight — Understand your own Workflows",
        "width": 370,
        "height": 700,
        "resizable": true,
        "fullscreen": false,
        "minWidth": 340,
        "minHeight": 400,
        "decorations": false,
        "backgroundColor": "#FAFAFA"
      }
    ],
    "security": {
      "csp": "default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'none'; form-action 'self'; img-src 'self' data: https:; font-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline'; connect-src 'self' ipc: http://ipc.localhost https://*.supabase.co wss://*.supabase.co ws://127.0.0.1:1420"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "windows": {
      "webviewInstallMode": {
        "type": "offlineInstaller",
        "silent": true
      }
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "../../../local_llm/bin/*.exe": "local_llm/bin/",
      "../../../local_llm/bin/*.dll": "local_llm/bin/",
      "../../../local_llm/APACHE-2.0.md": "local_llm/APACHE-2.0.md",
      "../../../local_llm/MODEL_NOTICE.md": "local_llm/MODEL_NOTICE.md",
      "../browser-extension/manifest.json": "browser-extension/manifest.json",
      "../browser-extension/options.html": "browser-extension/options.html",
      "../browser-extension/options.js": "browser-extension/options.js",
      "../browser-extension/worker.js": "browser-extension/worker.js"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEQzQjY4MDk5MDFDN0UxNkYKUldSdjRjY0JtWUMyMDAzY0VFeXUxVHRXMkZPeVJJVVcrOVZpdnR5Ym9wWldaOEk1M0pEajkrR3AK",
      "endpoints": [
        "https://github.com/Mancasvel/FlowSight.AI/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
